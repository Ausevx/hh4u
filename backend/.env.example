# Preserve the existing database and AI configuration when adding these values.
MONGODB_URI=mongodb://127.0.0.1:27017/hh4u
JWT_SECRET=
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
AUTH_EMAIL_FROM=Healing Hands4U <signin@your-verified-domain.com>
# Configure the actual trusted proxy count; leave unset for direct local access.
TRUST_PROXY_HOPS=

# Multilingual matching: Gemini is used ONLY for embeddings.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_TIMEOUT_MS=8000
# Google Cloud Translation Advanced; server Application Default Credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
TRANSLATION_TIMEOUT_MS=8000
# Optional pipe-separated medicine names/terms that must be preserved verbatim.
TRANSLATION_PROTECTED_TERMS=
# Optional full Cloud glossary resource name in the same location.
GOOGLE_TRANSLATION_GLOSSARY=
# Provisional thresholds: calibrate against reviewed multilingual question IDs.
MATCH_CONFIDENCE_THRESHOLD=0.75
MATCH_SCORE_MARGIN=0.03
# Production must use Atlas; do not silently scan the full corpus on index failures.
ALLOW_VECTOR_SCAN_FALLBACK=false

# Groq LLM & Multilingual Translation
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
